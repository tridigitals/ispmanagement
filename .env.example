# Application Name
VITE_APP_NAME="Tri Digital Solution"
APP_NAME="Tri Digital Solution"
APP_MAIN_DOMAIN=localhost

# Server Configuration
PORT=3000
# Browser web runtime should prefer same-origin `/api` so tenant custom domains work cleanly.
# Keep `VITE_API_URL` for Tauri/native builds or explicit remote debugging only.
# Example remote override: `https://api-isp-management.tridigitals.com/api`
VITE_API_URL=https://api-isp-management.tridigitals.com/api
# Legacy toggle kept for compatibility. Browser production should not depend on a remote API host.
VITE_USE_REMOTE_API=false
# Optional: allow extra hostnames through Vite dev server for Cloudflare Tunnel or demo links.
# Example: VITE_ALLOWED_HOSTS=billing.tridigitals.com
VITE_ALLOWED_HOSTS=
# Safety valve for intentionally unsafe dev exposure.
# Leave empty by default. Set to `1` only when you explicitly want `VITE_ALLOWED_HOSTS=all`.
ALLOW_UNSAFE_PUBLIC_DEV=

VAPID_PUBLIC_KEY=BIcJilKLh7Nz6S08bV-PFjh3HCfZ0YPXhhPH11HTaDMenYSvfAJCfvpyAFrmVLoD3LinpVHl2w2CMDPrmXc0Zjc
VAPID_PRIVATE_KEY=oLZajiMxOPAQQBt0cAlt6Cui0If6f5WGTVUsJVr7tuM

VITE_VAPID_PUBLIC_KEY=BIcJilKLh7Nz6S08bV-PFjh3HCfZ0YPXhhPH11HTaDMenYSvfAJCfvpyAFrmVLoD3LinpVHl2w2CMDPrmXc0Zjc

# Logging
RUST_LOG=info,saas_tauri=info

# MikroTik log retention window in days.
# Valid range: 1..3650. Invalid/missing values fall back to 90.
MIKROTIK_LOG_RETENTION_DAYS=90

# CORS Configuration (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# =================================
# PostgreSQL Docker Configuration
# =================================
POSTGRES_USER=isp_user
POSTGRES_PASSWORD=isp_password
POSTGRES_DB=isp_db
POSTGRES_PORT=5440
POSTGRES_HOST=localhost
POSTGRES_SSLMODE=disable

# Optional override (if you need special characters in credentials):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# =================================
# Managed RADIUS Runtime
# =================================
# Enable the native Rust RADIUS runtime listener.
RADIUS_ENABLED=true
# Bind address for the UDP listener. Use 0.0.0.0 on VPS/server deployments.
RADIUS_BIND_ADDR=0.0.0.0
# Public host/IP used in MikroTik `/radius add ... address=...`
# Fill this with the VPS public IP or DNS name that your routers can reach.
MANAGED_RADIUS_HOST=radius.example.com
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# =================================
# App Secret (Master Key)
# =================================
# Used to derive encryption keys (and can be used for other signing/encryption needs later).
# IMPORTANT: Do NOT change after you have data encrypted in the DB, unless you rotate keys properly.
APP_SECRET=change-me-to-a-long-random-secret

# Legacy (deprecated): kept for backward compatibility.
# MIKROTIK_CRED_KEY=change-me-to-a-long-random-secret

# =================================
# External PostgreSQL Examples
# =================================
# Supabase: DATABASE_URL=postgres://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Neon: DATABASE_URL=postgres://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
# Railway: DATABASE_URL=postgres://postgres:[PASSWORD]@[HOST].railway.app:5432/railway

# =================================
# For SQLite (optional)
# Run with: npm run tauri dev -- -- --features sqlite --no-default-features
# =================================
# DATABASE_URL=sqlite:./saas_app.db?mode=rwc
