client dynamic {
    ipaddr = 0.0.0.0/0
    dynamic_clients = dynamic_clients
    require_message_authenticator = yes
    lifetime = 5
}

server dynamic_clients {
    authorize {
        if ("%{sql:SELECT 1 FROM managed_radius_nas WHERE is_active = true AND '%{Packet-Src-IP-Address}'::inet <<= nas_ip_or_cidr::cidr ORDER BY masklen(nas_ip_or_cidr::cidr) DESC, updated_at DESC LIMIT 1}") {
            update control {
                &FreeRADIUS-Client-IP-Address = "%{Packet-Src-IP-Address}"
                &FreeRADIUS-Client-Secret = "%{sql:SELECT shared_secret FROM managed_radius_nas WHERE is_active = true AND '%{Packet-Src-IP-Address}'::inet <<= nas_ip_or_cidr::cidr ORDER BY masklen(nas_ip_or_cidr::cidr) DESC, updated_at DESC LIMIT 1}"
                &FreeRADIUS-Client-Shortname = "%{sql:SELECT COALESCE(shortname, nas_name) FROM managed_radius_nas WHERE is_active = true AND '%{Packet-Src-IP-Address}'::inet <<= nas_ip_or_cidr::cidr ORDER BY masklen(nas_ip_or_cidr::cidr) DESC, updated_at DESC LIMIT 1}"
                &FreeRADIUS-Client-NAS-Type = "other"
                &FreeRADIUS-Client-Virtual-Server = "default"
                &FreeRADIUS-Client-Require-MA = yes
            }
        }

        ok
    }
}
