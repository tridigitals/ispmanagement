sql {
    driver = "rlm_sql_postgresql"
    dialect = "postgresql"

    server = "__RADIUS_DB_HOST__"
    port = __RADIUS_DB_PORT__
    login = "__RADIUS_DB_USER__"
    password = "__RADIUS_DB_PASSWORD__"
    radius_db = "__RADIUS_DB_NAME__"

    read_clients = no
    read_groups = no
    delete_stale_sessions = no
    sql_user_name = "%{User-Name}"

    # FreeRADIUS 3.2.x still expects these variables to exist when loading the
    # stock PostgreSQL queries.conf. Our managed-RADIUS deployment overrides the
    # actual auth/client queries below, but the module parser fails early if the
    # table variables are undefined.
    client_table = "managed_radius_nas"
    authcheck_table = "managed_radius_accounts"
    authreply_table = "managed_radius_accounts"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    group_attribute = "Group"
    usergroup_table = "radusergroup"
    acct_table1 = "radacct"
    acct_table2 = "radacct"
    postauth_table = "radpostauth"

    pool {
        start = 1
        min = 1
        max = 8
        spare = 2
        uses = 0
        retry_delay = 30
        lifetime = 0
        cleanup_interval = 30
        idle_timeout = 60
    }

    authorize_check_query = "SELECT a.id, a.username, 'Cleartext-Password' AS attribute, a.cleartext_password AS value, ':=' AS op FROM managed_radius_accounts a INNER JOIN managed_radius_nas n ON n.tenant_id = a.tenant_id AND n.router_id = a.router_id WHERE a.username = '%{SQL-User-Name}' AND a.disabled = false AND n.is_active = true AND COALESCE(n.shortname, n.nas_name) = '%{client:shortname}' LIMIT 1"

    authorize_reply_query = "SELECT attrs.id, attrs.username, attrs.attribute, attrs.value, ':=' AS op FROM (SELECT a.id, a.username, 'Mikrotik-Group' AS attribute, a.profile_name AS value FROM managed_radius_accounts a INNER JOIN managed_radius_nas n ON n.tenant_id = a.tenant_id AND n.router_id = a.router_id WHERE a.username = '%{SQL-User-Name}' AND a.disabled = false AND a.profile_name IS NOT NULL AND n.is_active = true AND COALESCE(n.shortname, n.nas_name) = '%{client:shortname}' UNION ALL SELECT a.id, a.username, 'Framed-IP-Address' AS attribute, a.remote_address AS value FROM managed_radius_accounts a INNER JOIN managed_radius_nas n ON n.tenant_id = a.tenant_id AND n.router_id = a.router_id WHERE a.username = '%{SQL-User-Name}' AND a.disabled = false AND a.remote_address IS NOT NULL AND n.is_active = true AND COALESCE(n.shortname, n.nas_name) = '%{client:shortname}' UNION ALL SELECT a.id, a.username, 'Framed-Pool' AS attribute, a.address_pool AS value FROM managed_radius_accounts a INNER JOIN managed_radius_nas n ON n.tenant_id = a.tenant_id AND n.router_id = a.router_id WHERE a.username = '%{SQL-User-Name}' AND a.disabled = false AND a.address_pool IS NOT NULL AND n.is_active = true AND COALESCE(n.shortname, n.nas_name) = '%{client:shortname}') attrs"

}
