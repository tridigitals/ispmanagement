server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }

    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        sql
        chap
        mschap
        pap
    }

    authenticate {
        Auth-Type CHAP {
            chap
        }

        Auth-Type MS-CHAP {
            mschap
        }

        Auth-Type PAP {
            pap
        }
    }

    accounting {
        ok
    }

    post-auth {
        ok
    }
}
