# Example environment for `isp-management.service`
#
# Copy to: /etc/isp-management/server.env
#   sudo install -d -m 0750 /etc/isp-management
#   sudo install -m 0640 deploy/systemd/server.env.example /etc/isp-management/server.env
#
# Then edit values:
#   sudoedit /etc/isp-management/server.env

# HTTP port (Axum reads `PORT`)
PORT=3000

# Logging
RUST_LOG=info,saas_tauri=info

# MikroTik log retention window in days.
# Valid range: 1..3650. Invalid/missing values fall back to 90.
MIKROTIK_LOG_RETENTION_DAYS=90

# =========================
# Database (pick one)
# =========================

# Option A (recommended): explicit DATABASE_URL
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable

# Option B: POSTGRES_* envs (used when DATABASE_URL is not set)
POSTGRES_USER=ispmanagement
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ispmanagement
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# App secret (do NOT change after production data exists without key rotation)
APP_SECRET=change-me-to-a-long-random-secret

# CORS (comma-separated, no trailing slash)
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Optional: automatically restart FreeRADIUS after NAS mapping edits that change
# client-facing fields such as NAS IP/CIDR or shared secret.
# The service user must be allowed to run the command below successfully.
# Example:
# MANAGED_RADIUS_RESTART_COMMAND=/opt/isp-management/scripts/restart-freeradius.sh
# MANAGED_RADIUS_RESTART_WORKDIR=/opt/isp-management
# MANAGED_RADIUS_COMPOSE_FILE=docker-compose.radius.yml
# MANAGED_RADIUS_SERVICE_NAME=freeradius
